<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:fillViewport="true" android:background="#F5F7FB" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="قَدَم" android:textSize="34sp" android:textStyle="bold" android:textColor="#16A34A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="ورود با شماره موبایل" android:textSize="17sp" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/phone" android:hint="شماره موبایل" android:inputType="phone" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/code" android:hint="کد ۶ رقمی OTP" android:inputType="number" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/otp" android:text="دریافت کد ورود" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/steps" android:text="۰ قدم" android:textSize="38sp" android:textStyle="bold" android:gravity="center" android:padding="28dp" android:layout_marginTop="20dp" android:background="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/wallet" android:text="موجودی: ۰ ریال" android:textSize="18sp" android:padding="18dp" android:background="#FFFFFF" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/sync" android:text="خواندن و همگام‌سازی قدم‌ها" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="نسخه Android Studio — API آماده اتصال به سرور قدم" android:textSize="13sp" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
